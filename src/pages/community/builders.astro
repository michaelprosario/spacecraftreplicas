---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Community Builders Showcase">
  <div style="max-width: 900px; margin: 0 auto;">
    <span class="badge">Community</span>
    <h1 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Community Builders Showcase</h1>
    
    <div class="article-content">
      <p>Here are some photos from builders.</p>
      
        <div style="margin-top: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
            <img src="/images/352-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM034a5-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0322-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0338-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0342-112x150.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0342a-1-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0342a-2-150x112.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" /><img src="/images/PDRM0343a-112x150.jpg" alt="Community Builders Showcase" style="width:100%; border-radius:8px; border:1px solid var(--border-color);" />
        </div>
        
    </div>
  </div>
</MainLayout>
